    BEGIN
      VALUE "CompanyName", "WoW Forever Addon Manager"
      VALUE "FileDescription", "WoW Forever Addon Manager Setup"
      VALUE "FileVersion", "3.8.1"
      VALUE "ProductName", "WoW Forever Addon Manager"
      VALUE "ProductVersion", "3.8.1"
      VALUE "OriginalFilename", "WoWForeverAddons-Setup-3.8.1.exe"
      VALUE "InternalName", "WoWForeverAddons-Setup"
      VALUE "LegalCopyright", "Free to use"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
