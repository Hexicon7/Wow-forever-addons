1 ICON "payload/icon.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 3,18,0,0
PRODUCTVERSION 3,18,0,0
FILEFLAGSMASK 0x3f
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "WoW Forever Addon Manager"
      VALUE "FileDescription", "WoW Forever Addons"
      VALUE "FileVersion", "3.18.0"
      VALUE "ProductName", "WoW Forever Addon Manager"
      VALUE "ProductVersion", "3.18.0"
      VALUE "OriginalFilename", "WoW Forever Addons.exe"
      VALUE "InternalName", "WoWForeverAddons"
      VALUE "LegalCopyright", "Free to use. Uses Microsoft Edge WebView2 and go-webview2 (MIT)."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
